APP_NAME="NetVera Teknoloji Yazılım"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://netvera.tr

DB_HOST=127.0.0.1
DB_NAME=CPANEL_DB_NAME
DB_USER=CPANEL_DB_USER
DB_PASS=SET_SECURE_PASSWORD
DB_CHARSET=utf8mb4

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@netvera.tr
MAIL_FROM_NAME="NetVera Teknoloji Yazılım"

# Lisans Ayarları
LICENSE_ENABLED=false
LICENSE_SERVER_URL=
LICENSE_PRODUCT_CODE=yorum-panel-pro
LICENSE_KEY=
LICENSE_INSTALL_ID=
LICENSE_CHECK_INTERVAL_HOURS=24
LICENSE_GRACE_DAYS=3
LICENSE_LOCAL_BYPASS=false

# SMM provider API secrets are encrypted at rest. Generate with:
# php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
# Never put this real value in GitHub; losing it makes saved provider keys unreadable.
SMM_ENCRYPTION_KEY=

# Telegram alerts: keep real credentials only in production .env (never commit).
NETVERA_TELEGRAM_BOT_TOKEN=
NETVERA_TELEGRAM_CHAT_ID=
